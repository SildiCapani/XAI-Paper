@@ -0,0 +1,79 @@
+#!/bin/bash
+
+#SBATCH --job-name=linien_verdeckung   # beim Aufruf mit --job-name=<USERNAME>_... überschreiben (Pflicht-Nomenklatur)
+#SBATCH --partition=debug
+#SBATCH --gres=gpu:user:1
+#SBATCH --cpus-per-task=24
+#SBATCH --mem=128G
+#SBATCH --time=08:00:00
+#SBATCH --output=slurm-outs/slurm-%j.out
+
+# Fine-Tuning ab best_model_bev_2026.pth mit gezielter Linien-Verdeckung (XAI-Paper).
+# Ein Skript für alle Schritte, Auswahl über MODE:
+#   sbatch --job-name=${USER}_vorschau   --export=ALL,MODE=vorschau   linien_verdeckung.slurm
+#   sbatch --job-name=${USER}_kontrolle  --export=ALL,MODE=kontrolle  linien_verdeckung.slurm
+#   sbatch --job-name=${USER}_verdeckung --export=ALL,MODE=verdeckung linien_verdeckung.slurm
+#   sbatch --job-name=${USER}_eval       --export=ALL,MODE=eval       linien_verdeckung.slurm
+# vorschau:   Trainingsbilder mit Labels und zufälliger Verdeckung als JPG (prüfen, ob die Labels auf den Linien liegen)
+# kontrolle:  Fine-Tuning ohne neue Augmentation (Vergleichslauf)
+# verdeckung: Fine-Tuning mit Linien-Verdeckung (aug_lane_occlusion_p = 0.5)
+# eval:       Basis, Kontrolle und Verdeckung auf den Validierungsbildern vergleichen (sauber und verdeckt)
+
+set -euo pipefail
+
+MODE="${MODE:?MODE setzen: vorschau | kontrolle | verdeckung | eval}"
+
+# ---- an deinen Account anpassen ----
+PROJECT_DIR="${PROJECT_DIR:-$HOME/lane_detection_ai_training}"                 # dein Klon des Repos (Branch training + Patch)
+DATA_DIR="${DATA_DIR:-$PROJECT_DIR/dataset/smartrollerz_bev}"                  # Datensatz mit labels/train_gt.txt, eval_gt.txt, *_cache.json
+RESULTS_DIR="${RESULTS_DIR:-$PROJECT_DIR/results}"                             # Trainingsläufe, MLflow, Auswertung
+CONTAINER_IMAGE="${CONTAINER_IMAGE:-$HOME/containers/lane_detection_ai_training.sqsh}"
+# ------------------------------------
+
+APP=/app
+mkdir -p "$RESULTS_DIR" "$PROJECT_DIR/.cache/torch" "$PROJECT_DIR/.config/matplotlib"
+# Einhängepunkte müssen im Projektordner existieren (auch wenn die Daten woanders liegen)
+mkdir -p "$PROJECT_DIR/dataset/smartrollerz_bev" "$PROJECT_DIR/results" slurm-outs
+for f in "$DATA_DIR/labels/train_gt.txt" "$DATA_DIR/labels/smartrollerz_anno_cache.json" \
+         "$PROJECT_DIR/configs/pretrained_models/best_model_bev_2026.pth" "$CONTAINER_IMAGE"; do
+  [[ -e "$f" ]] || { echo "[FEHLER] fehlt: $f"; exit 1; }
+done
+echo "[INFO] MODE=$MODE  Projekt=$PROJECT_DIR  Daten=$DATA_DIR  Ergebnisse=$RESULTS_DIR"
+
+export NVIDIA_VISIBLE_DEVICES=all
+export NVIDIA_DRIVER_CAPABILITIES=compute,utility
+export MODE
+
+srun --container-image="$CONTAINER_IMAGE" \
+  --container-mounts="$PROJECT_DIR:$APP,$DATA_DIR:$APP/dataset/smartrollerz_bev,$RESULTS_DIR:$APP/results" \
+  bash -lc '
+    set -euo pipefail
+    export XDG_CACHE_HOME=/app/.cache TORCH_HOME=/app/.cache/torch MPLCONFIGDIR=/app/.config/matplotlib
+    cd /app
+    nvidia-smi -L
+    DATA=/app/dataset/smartrollerz_bev
+    case "$MODE" in
+      vorschau)
+        python3 eval_verdeckung.py configs/smartrollerz_bev2026_ft_verdeckung.py \
+          --data_root "$DATA" --list labels/train_gt.txt --out results/eval_verdeckung/vorschau --vorschau 30
+        ;;
+      kontrolle|verdeckung)
+        python3 train_lightning.py configs/smartrollerz_bev2026_ft_$MODE.py \
+          --dataset Smartrollerz --data_root "$DATA" --log_path /app/results \
+          --mlflow_uri file:///app/results/mlruns --mlflow_experiment xai_linien_verdeckung \
+          --mlflow_run_name ft_$MODE --eval_during_training True
+        ;;
+      eval)
+        # jeweils der neueste Lauf; mit KONTROLLE_RUN / VERDECKUNG_RUN (Ordnername in results/) festlegen
+        K="${KONTROLLE_RUN:-$(ls -d results/*_ft_kontrolle 2>/dev/null | tail -1 | xargs -r basename)}"
+        V="${VERDECKUNG_RUN:-$(ls -d results/*_ft_verdeckung 2>/dev/null | tail -1 | xargs -r basename)}"
+        W="basis=configs/pretrained_models/best_model_bev_2026.pth"
+        [[ -n "$K" ]] && W="$W kontrolle=results/$K/best_weights.pth"
+        [[ -n "$V" ]] && W="$W verdeckung=results/$V/best_weights.pth"
+        echo "[INFO] Modelle: $W"
+        python3 eval_verdeckung.py configs/smartrollerz_bev2026_ft_verdeckung.py \
+          --weights $W --data_root "$DATA" --out results/eval_verdeckung
+        ;;
+      *) echo "[FEHLER] unbekannter MODE=$MODE"; exit 1 ;;
+    esac
+  '
