@@ -0,0 +1,19 @@
+import torch
+
+
+def load_parsingnet_weights(model, path: str, strict: bool = True):
+    """Lädt Gewichte in ein parsingNet, egal in welchem der drei Formate sie gespeichert sind:
+    Lightning-.ckpt {"state_dict": ...}, best_weights.pth {"model": ...} oder ein flaches
+    LightningModule-state_dict mit Präfix "model." (z. B. best_model_bev_2026.pth).
+    Gibt (geladen, gesamt, unerwartet) zurück."""
+    state = torch.load(path, map_location="cpu")
+    if "state_dict" in state:
+        state = state["state_dict"]
+    elif isinstance(state.get("model"), dict):
+        state = state["model"]
+    own = set(model.state_dict())
+    stripped = {k.removeprefix("model."): v for k, v in state.items()}
+    if len(own & set(stripped)) > len(own & set(state)):
+        state = stripped
